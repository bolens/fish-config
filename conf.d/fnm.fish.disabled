# Inactive example: mise owns runtime selection in the maintained configuration.
# If deliberately restored, generate current process state instead of retaining
# a past host's UID, multishell directory, or absolute home path.
set -gx FNM_DIR "$HOME/.local/share/fnm"
fish_add_path -p --path "$FNM_DIR"
if command -q fnm
    fnm env --shell fish | source
end
